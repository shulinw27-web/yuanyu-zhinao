  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Receipt": {
        "type": "object",
        "title": "收货单头",
        "description": "合成案例 WMS.Receipt；粒度=transaction；主键需结合来源及组织隔离。",
        "x-source-system": "WMS",
        "x-primary-key": "receipt_id",
        "x-granularity": "transaction",
        "required": [
          "receipt_id",
          "po_id",
          "received_at"
        ],
        "properties": {
          "receipt_id": {
            "type": "string",
            "description": "receipt_id"
          },
          "po_id": {
            "type": "string",
            "description": "标量外键，引用 PurchaseOrder 主键；不是嵌套对象。",
            "x-foreign-key": {
              "schema": "PurchaseOrder",
              "field": "po_id"
            }
          },
          "received_at": {
            "type": "string",
            "description": "received_at"
          }
        }
      },
      "ReceiptLine": {
        "type": "object",
        "title": "收货明细",
        "description": "合成案例 WMS.ReceiptLine；粒度=transaction；主键需结合来源及组织隔离。",
        "x-source-system": "WMS",
        "x-primary-key": "receipt_line_id",
        "x-granularity": "transaction",
        "required": [
          "receipt_line_id",
          "receipt_id",
          "po_line_id",
          "lot_id",
          "received_qty",
          "unit"
        ],
        "properties": {
          "receipt_line_id": {
            "type": "string",
            "description": "receipt_line_id"
          },
          "receipt_id": {
            "type": "string",
            "description": "标量外键，引用 Receipt 主键；不是嵌套对象。",
            "x-foreign-key": {
              "schema": "Receipt",
              "field": "receipt_id"
            }
          },
          "po_line_id": {
            "type": "string",
            "description": "标量外键，引用 PurchaseLine 主键；不是嵌套对象。",
            "x-foreign-key": {
              "schema": "PurchaseLine",
              "field": "po_line_id"
            }
          },
          "lot_id": {
            "type": "string",
            "description": "标量外键，引用 MaterialLot 主键；不是嵌套对象。",
            "x-foreign-key": {
              "schema": "MaterialLot",
              "field": "lot_id"
            }
          },
          "received_qty": {
            "type": "number",
            "description": "received_qty"
          },
          "unit": {
            "type": "string",
            "description": "数量单位，g与kg需按明确规则转换"
          }
        }
      },
      "MaterialLot": {
        "type": "object",
        "title": "来料批次",
        "description": "合成案例 WMS.MaterialLot；粒度=batch；主键需结合来源及组织隔离。",
        "x-source-system": "WMS",
        "x-primary-key": "lot_id",
        "x-granularity": "batch",
        "required": [
          "lot_id",
          "material_id",
          "supplier_id",
          "supplier_lot_no"
        ],
        "properties": {
          "lot_id": {
            "type": "string",
            "description": "lot_id"
          },
          "material_id": {
            "type": "string",
            "description": "标量外键，引用 Material 主键；不是嵌套对象。",
            "x-foreign-key": {
              "schema": "Material",
              "field": "material_id"
            }
          },
          "supplier_id": {
            "type": "string",
            "description": "标量外键，引用 Supplier 主键；不是嵌套对象。",
            "x-foreign-key": {
              "schema": "Supplier",
              "field": "supplier_id"
            }
          },
          "supplier_lot_no": {
            "type": "string",
            "description": "supplier_lot_no"
          }
        }
      },
      "StockItem": {
        "type": "object",
        "title": "库位库存快照",
        "description": "合成案例 WMS.StockItem；粒度=inventory_item；主键需结合来源及组织隔离。",
        "x-source-system": "WMS",
        "x-primary-key": "stock_id",
        "x-granularity": "inventory_item",
        "required": [
          "stock_id",
          "lot_id",
          "warehouse_id",
          "bin_id",
          "on_hand",
          "reserved",
          "available",
          "unit",
          "status",
          "as_of"
        ],
        "properties": {
          "stock_id": {
            "type": "string",
            "description": "stock_id"
          },
          "lot_id": {
            "type": "string",
            "description": "标量外键，引用 MaterialLot 主键；不是嵌套对象。",
            "x-foreign-key": {
              "schema": "MaterialLot",
              "field": "lot_id"
            }
          },
          "warehouse_id": {
            "type": "string",
            "description": "warehouse_id"
          },
          "bin_id": {
            "type": "string",
            "description": "bin_id"
          },
          "on_hand": {
            "type": "number",
            "description": "on_hand"
          },
          "reserved": {
            "type": "number",
            "description": "reserved"
          },
          "available": {
            "type": "number",
            "description": "库位快照可用量，受控状态为0，不是总量。"
          },
          "unit": {
            "type": "string",
            "description": "数量单位，g与kg需按明确规则转换"
          },
          "status": {
            "type": "string",
            "description": "status"
          },
          "as_of": {
            "type": "string",
            "description": "含时区ISO8601快照时间"
          }
        }
      }
    }
  }
}
