{
  "openapi": "3.0.3",
  "info": {
    "title": "SYNTHETIC WMS API",
    "version": "1.0.0",
    "description": "依公开业务流程重建，不是厂商API复制，不含企业真实数据。"
  },
  "servers": [
    {
      "url": "https://synthetic-factory.example.invalid"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/wms/v1/Receipt": {
      "get": {
        "operationId": "listReceipt",
        "summary": "分页读取收货单头",
        "description": "租户/组织/字段鉴权。403不得升级身份。分页返回nextCursor；增量可能重复，事件按(system,id,version)去重。",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updatedSince",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前授权页，不代表全部",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Receipt"
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "无权限"
          },
          "429": {
            "description": "限流，按Retry-After重试"
          }
        }
      }
    },
