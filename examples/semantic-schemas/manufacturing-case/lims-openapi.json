{
  "openapi": "3.0.3",
  "info": {
    "title": "SYNTHETIC LIMS API",
    "version": "1.0.0",
    "description": "依公开业务流程重建，不是厂商API复制，不含企业真实数据。"
  },
  "servers": [
    {
      "url": "https://synthetic-factory.example.invalid"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/lims/v1/Inspection": {
      "get": {
        "operationId": "listInspection",
        "summary": "分页读取检验记录",
        "description": "租户/组织/字段鉴权。403不得升级身份。分页返回nextCursor；增量可能重复，事件按(system,id,version)去重。",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updatedSince",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当前授权页，不代表全部",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Inspection"
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "无权限"
          },
          "429": {
            "description": "限流，按Retry-After重试"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Inspection": {
        "type": "object",
        "title": "检验记录",
        "description": "合成案例 LIMS.Inspection；粒度=event；主键需结合来源及组织隔离。",
        "x-source-system": "LIMS",
        "x-primary-key": "inspection_id",
        "x-granularity": "event",
        "required": [
          "inspection_id",
          "lot_id",
          "result",
          "measured_value",
          "limit_value",
          "measured_at"
        ],
        "properties": {
          "inspection_id": {
            "type": "string",
            "description": "inspection_id"
          },
          "lot_id": {
            "type": "string",
            "description": "标量外键，引用 MaterialLot 主键；不是嵌套对象。",
            "x-foreign-key": {
              "schema": "MaterialLot",
              "field": "lot_id"
            }
          },
          "result": {
            "type": "string",
            "description": "result"
          },
          "measured_value": {
            "type": "number",
            "description": "measured_value"
          },
          "limit_value": {
            "type": "number",
            "description": "limit_value"
          },
          "measured_at": {
            "type": "string",
            "description": "measured_at"
          }
        }
      }
    }
  }
}
