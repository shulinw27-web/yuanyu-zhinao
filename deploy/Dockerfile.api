FROM node:22.18.0-bookworm-slim AS dependencies

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY apps/desktop/package.json apps/desktop/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY apps/semantic-operations-console/package.json apps/semantic-operations-console/package.json
COPY packages/agent-sdk/package.json packages/agent-sdk/package.json
COPY packages/agent-workbench/package.json packages/agent-workbench/package.json
COPY packages/api-contracts/package.json packages/api-contracts/package.json
COPY packages/client-runtime/package.json packages/client-runtime/package.json
COPY packages/semantic-operations-sdk/package.json packages/semantic-operations-sdk/package.json

RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM node:22.18.0-bookworm-slim AS runtime

ENV NODE_ENV=production \
    API_HOST=0.0.0.0 \
    PORT=3001

WORKDIR /app

COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node backend ./backend
COPY --chown=node:node packages ./packages
COPY --chown=node:node package.json package-lock.json ./

USER node
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "require('node:http').get('http://127.0.0.1:3001/api/health/live',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]

CMD ["node", "backend/src/app.js"]
