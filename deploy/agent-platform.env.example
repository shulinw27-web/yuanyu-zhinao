# 服务端：仅部署环境使用；不可提交真实值
NODE_ENV=development
API_HOST=127.0.0.1
PORT=3001
DEMO_ALLOW_ROLE_HEADER=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 开发/单节点 Mock 默认使用 SQLite；测试可切换为 memory
RUNTIME_STORE_DRIVER=sqlite
RUNTIME_SQLITE_PATH=backend/.data/runtime.db
SINGLE_NODE_DEPLOYMENT=true
IDENTITY_SESSION_STORE_DRIVER=runtime
IAM_STORE_DRIVER=runtime
RISK_PROCUREMENT_STORE_DRIVER=runtime
ALERTING_STORE_DRIVER=runtime
SIMULATION_STORE_DRIVER=runtime
SEMANTIC_GOVERNANCE_STORE_DRIVER=runtime
AGENT_RUN_STORE_DRIVER=runtime
EVIDENCE_TRACE_STORE_DRIVER=runtime
AGENT_CONVERSATION_STORE_DRIVER=runtime
AGENT_LEARNING_STORE_DRIVER=runtime
AGENT_ORCHESTRATION_STORE_DRIVER=runtime
DOMAIN_EVENT_STORE_DRIVER=runtime
# PostgreSQL incremental migration adapter. Semantic governance publication requires DOMAIN_EVENT_STORE_DRIVER=postgres in production.
# RUNTIME_POSTGRES_URL=postgresql://agent_runtime:secret@postgres.internal:5432/agent_platform?sslmode=require
# RUNTIME_POSTGRES_POOL_MAX=10
# RUNTIME_POSTGRES_STATEMENT_TIMEOUT_MS=5000
# After running migrate:postgres, identity sessions, IAM, and risk/procurement can be switched independently. PostgreSQL business/IAM modes also require DOMAIN_EVENT_STORE_DRIVER=postgres.
AGENT_RUNTIME_MODE=mock
# 一次性 Agent 确认凭据有效期；服务端限制为 30 秒到 30 分钟
AGENT_CONFIRMATION_TTL_MS=600000
AGENT_ORCHESTRATION_WORKER_INTERVAL_MS=30000
# AGENT_ORCHESTRATION_WORKER_ID=agent-orchestration-worker-01
API_MAX_BODY_BYTES=18874368

# 领域事件 Worker；外部 Broker 需要在部署组合层注入 publisher
EVENT_BROKER_TYPE=projection
EVENT_WORKER_CONSUMER_ID=internal-projection-worker
EVENT_WORKER_TENANT_ID=demo-enterprise
EVENT_WORKER_BATCH_SIZE=20
EVENT_WORKER_INTERVAL_MS=2000
# EVENT_WEBHOOK_URL=https://event-gateway.example.internal/domain-events
# EVENT_WEBHOOK_SIGNING_SECRET=replace-with-kms-injected-secret
# EVENT_WEBHOOK_TIMEOUT_MS=10000
# EVENT_KAFKA_BROKERS=kafka-a:9093,kafka-b:9093
# EVENT_KAFKA_TOPIC=domain-events
# EVENT_KAFKA_CLIENT_ID=healthcare-ai-domain-event-worker
# EVENT_KAFKA_SSL=true
# EVENT_KAFKA_USERNAME=replace-with-workload-identity
# EVENT_KAFKA_PASSWORD=replace-with-kms-injected-secret
# EVENT_RABBITMQ_URL=amqps://worker:replace-with-secret@rabbit.example.internal/vhost
# EVENT_RABBITMQ_EXCHANGE=domain.events
LOCAL_LLM_BASE_URL=http://llm-gateway.intra/v1
LOCAL_LLM_MODEL=qwen2.5:14b-instruct
LOCAL_LLM_API_KEY=replace-with-kms-injected-secret
MODEL_ALLOWLIST_JSON={"mock":[],"local":["qwen2.5:14b-instruct"],"openai":[],"deepseek":[],"compatible":[],"workbuddy":[]}
MODEL_MAX_CONCURRENT=4
MODEL_DAILY_CALL_LIMIT=500
MODEL_DAILY_TOKEN_LIMIT=2000000
MODEL_MAX_RESERVED_OUTPUT_TOKENS=4096
MODEL_INPUT_COST_PER_MILLION_USD_JSON={"mock":0,"local":0,"openai":2,"deepseek":0.5,"compatible":0,"workbuddy":0}

# 生产必须禁用 Mock Connector，并通过 KMS 引用提供真实连接器凭据。
CONNECTOR_MOCK_MODE=disabled
CONNECTOR_MAX_CONCURRENT_PER_SYSTEM=4
CONNECTOR_CIRCUIT_FAILURE_THRESHOLD=5
CONNECTOR_CIRCUIT_COOLDOWN_MS=30000
# ENTERPRISE_CONNECTORS_CONFIG_JSON={"erp":{"baseUrl":"https://erp.example.internal","credentialReference":"kms://agent/erp"}}

# 内容扫描在生产设置为 required；扫描服务不可用时上传失败关闭。
MULTIMODAL_CONTENT_SECURITY_MODE=required
MULTIMODAL_SECURITY_SCAN_ENDPOINT=https://content-security.example.internal/v1/scan
MULTIMODAL_OCR_ENDPOINT=https://ocr.example.internal/v1/extract

# 客户端低于最低版本或未携带版本标识时，生产 API 返回 426。
CLIENT_VERSION_POLICY_JSON={"web":{"minimumVersion":"0.1.0","recommendedVersion":"0.1.0"},"desktop":{"minimumVersion":"0.3.0","recommendedVersion":"0.3.0"},"mobile":{"minimumVersion":"0.3.0","recommendedVersion":"0.3.0"},"semantic-web":{"minimumVersion":"0.2.0","recommendedVersion":"0.2.0"},"semantic-desktop":{"minimumVersion":"0.2.0","recommendedVersion":"0.2.0"}}

# SIEM/指标鉴权仅填写 KMS 引用；不得粘贴明文 Token。
SIEM_EXPORT_URL=https://siem-gateway.example.internal/events
# 下列值由 KMS/Secret Manager 在运行时注入，此示例不放明文。
SIEM_EXPORT_TOKEN=inject-at-runtime-from-kms
# SIEM_EXPORT_HMAC_SECRET=inject-at-runtime-from-kms
OBSERVABILITY_METRICS_TOKEN=inject-at-runtime-from-kms

# OpenAI Demo：仅部署环境设置；禁止写入前端、Tauri 配置或代码仓库
# 启用前显式改为 AGENT_RUNTIME_MODE=openai
OPENAI_API_KEY=replace-with-kms-injected-secret
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_TEXT_VERBOSITY=medium
# redacted 为默认值；full 仅可在完成数据出境评估后使用
AGENT_EXTERNAL_DATA_MODE=redacted

# DeepSeek Demo：只允许在服务端/KMS 设置；启用时改为 AGENT_RUNTIME_MODE=deepseek
DEEPSEEK_API_KEY=replace-with-kms-injected-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 请按 DeepSeek 官方文档和账号可用模型更新此值
DEEPSEEK_MODEL=deepseek-v4-pro

# 其他符合 OpenAI Chat Completions 协议的供应商或企业网关
# 启用时改为 AGENT_RUNTIME_MODE=compatible
COMPATIBLE_LLM_BASE_URL=https://llm-gateway.example.internal/v1
COMPATIBLE_LLM_API_KEY=replace-with-kms-injected-secret
COMPATIBLE_LLM_MODEL=your-model-id

# 正式实现由 OIDC/JWKS 验证服务读取，不向客户端透传
OA_AUTH_MODE=mock
ACCOUNT_AUTH_MODE=mock
OIDC_ISSUER=https://sso.example.internal
OIDC_AUDIENCE=healthcare-ai-agent
OIDC_JWKS_URI=https://sso.example.internal/.well-known/jwks.json
OIDC_TENANT_ID=enterprise-tenant-id
OIDC_ACCOUNT_CLAIM=email
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
KMS_KEY_REFERENCE=kms://healthcare-ai/agent-runtime
KEY_CENTER_PROVIDER=demo-kms
# KEY_CENTER_PROVIDER_URL=https://credential-broker.example.com
# KEY_CENTER_WORKLOAD_ID=agent-api
# KEY_CENTER_PROVIDER_TIMEOUT_MS=5000
# KEY_CENTER_PROVIDER_BEARER_TOKEN=replace-with-workload-identity-token

# 生产切换清单（缺任一项 API 将拒绝启动）：
# NODE_ENV=production
# DEMO_ALLOW_ROLE_HEADER=false
# OA_AUTH_MODE=oidc
# ACCOUNT_AUTH_MODE=enterprise
# AGENT_RUNTIME_MODE=local|openai|deepseek|compatible
# KEY_CENTER_PROVIDER=vault|cloud-kms|hsm
# CORS_ALLOWED_ORIGINS=https://admin.example.internal,https://agent.example.internal
# SQLite 只允许 SINGLE_NODE_DEPLOYMENT=true；多节点需先实现 PostgreSQL Repository。

# Electron 正式包使用；仅允许企业 HTTPS，localhost HTTP 只用于本地 Demo
ZHINAO_API_BASE_URL=https://agent-gateway.example.internal/api
# 浏览器构建通常使用同源 /api；跨域部署时才显式设置
VITE_API_BASE_URL=https://agent-gateway.example.internal/api
VITE_AGENT_API_BASE_URL=https://agent-gateway.example.internal/api

# 通知适配器仅保存 KMS 引用
SMS_CREDENTIAL_REFERENCE=kms://healthcare-ai/sms
EMAIL_CREDENTIAL_REFERENCE=kms://healthcare-ai/email
WEBHOOK_SIGNING_KEY_REFERENCE=kms://healthcare-ai/webhook
