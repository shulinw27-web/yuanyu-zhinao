# mock: Demo mode, no external model is called. local: calls your private OpenAI-compatible model endpoint.
AGENT_RUNTIME_MODE=mock
NODE_ENV=development
API_HOST=127.0.0.1
PORT=3001
# Demo only. Set to false in production and require an identity session for every protected API.
DEMO_ALLOW_ROLE_HEADER=true
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5184,http://localhost:5184
API_MAX_BODY_BYTES=18874368
API_RATE_LIMIT=240
AUTH_RATE_LIMIT=12
AGENT_RATE_LIMIT=45
# One-time Agent confirmation validity. Server clamps the value to 30 seconds - 30 minutes.
AGENT_CONFIRMATION_TTL_MS=600000
AGENT_ORCHESTRATION_WORKER_INTERVAL_MS=30000
# AGENT_ORCHESTRATION_WORKER_ID=agent-orchestration-worker-01

# Durable local runtime state. memory is test-only. SQLite is single-node only.
RUNTIME_STORE_DRIVER=sqlite
# RUNTIME_SQLITE_PATH=D:/data/healthcare-ai/runtime.db
SINGLE_NODE_DEPLOYMENT=true
# Incremental migration: identity sessions, IAM, and risk/procurement aggregates can move independently after migrations run.
IDENTITY_SESSION_STORE_DRIVER=runtime
IAM_STORE_DRIVER=runtime
RISK_PROCUREMENT_STORE_DRIVER=runtime
ALERTING_STORE_DRIVER=runtime
SIMULATION_STORE_DRIVER=runtime
SEMANTIC_GOVERNANCE_STORE_DRIVER=runtime
AGENT_RUN_STORE_DRIVER=runtime
EVIDENCE_TRACE_STORE_DRIVER=runtime
AGENT_CONVERSATION_STORE_DRIVER=runtime
AGENT_LEARNING_STORE_DRIVER=runtime
AGENT_ORCHESTRATION_STORE_DRIVER=runtime
DOMAIN_EVENT_STORE_DRIVER=runtime
# Set an individual driver to postgres after applying migrations. Semantic governance publication also requires DOMAIN_EVENT_STORE_DRIVER=postgres in production.
# RUNTIME_POSTGRES_URL=postgresql://agent_runtime:secret@postgres.internal:5432/agent_platform?sslmode=require
# RUNTIME_POSTGRES_POOL_MAX=10
# RUNTIME_POSTGRES_STATEMENT_TIMEOUT_MS=5000

# Domain-event delivery. projection is built in; kafka/rabbitmq/webhook require an injected publisher adapter.
EVENT_BROKER_TYPE=projection
EVENT_WORKER_CONSUMER_ID=internal-projection-worker
EVENT_WORKER_TENANT_ID=demo-enterprise
EVENT_WORKER_BATCH_SIZE=20
EVENT_WORKER_INTERVAL_MS=2000
# Webhook Broker only. Inject the secret through KMS/Secret Manager, never commit a real value.
# EVENT_WEBHOOK_URL=https://event-gateway.example.internal/domain-events
# EVENT_WEBHOOK_SIGNING_SECRET=replace-with-secret-manager-reference
# EVENT_WEBHOOK_TIMEOUT_MS=10000
# Kafka: EVENT_KAFKA_BROKERS=kafka-a:9093,kafka-b:9093  EVENT_KAFKA_TOPIC=domain-events  EVENT_KAFKA_SSL=true
# RabbitMQ: EVENT_RABBITMQ_URL=amqps://worker:secret@rabbit.example.internal/vhost  EVENT_RABBITMQ_EXCHANGE=domain.events
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:14b-instruct
# Leave empty when your local endpoint does not require an API key.
LOCAL_LLM_API_KEY=
# Model HTTP request deadline in milliseconds (including response body).
AGENT_MODEL_TIMEOUT_MS=30000

# Ark cloud inference: npm run start:ark selects ark and ignores saved local UI overrides.
# Inject ARK_API_KEY through the service environment, never commit a real key.
# start:ark/check:ark also accept an external private JSON file (not dotenv).
# ARK_CONFIG_FILE=D:/wsl/private/yuanyu-zhinao/ark.json
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
ARK_MAX_TOKENS=2048
ARK_THINKING_MODE=disabled
AGENT_EXTERNAL_DATA_MODE=redacted
# Set ARK_MODEL to your enabled exact model ID or ep-... endpoint ID, and add
# the same value under "ark" in MODEL_ALLOWLIST_JSON before starting.

# WorkBuddy 云服务免密钥模型（config/workbuddy-cloud.json，publishableKey 为应用级公开凭据）。
# 端点与凭据由配置文件固定；如需固定其他模型，先在 allowedModels 中加入精确 ID 再设置此变量。
# WORKBUDDY_CLOUD_MODEL=auto
# WORKBUDDY_CLOUD_CONFIG_FILE=/absolute/path/to/workbuddy-cloud.json

# Model governance. Keep the allowlist exact; production startup rejects an unapproved model/version.
MODEL_ALLOWLIST_JSON={"mock":["deterministic-demo"],"local":["qwen2.5:14b-instruct"],"openai":[],"deepseek":[],"compatible":[],"ark":[],"workbuddy":[]}
MODEL_MAX_CONCURRENT=4
MODEL_DAILY_CALL_LIMIT=500
MODEL_DAILY_TOKEN_LIMIT=2000000
MODEL_MAX_RESERVED_OUTPUT_TOKENS=4096
MODEL_INPUT_COST_PER_MILLION_USD_JSON={"mock":0,"local":0,"openai":2,"deepseek":0.5,"compatible":0,"workbuddy":0}

# Connector governance. Production must disable Mock connectors explicitly.
CONNECTOR_MOCK_MODE=enabled
CONNECTOR_MAX_CONCURRENT_PER_SYSTEM=4
CONNECTOR_CIRCUIT_FAILURE_THRESHOLD=5
CONNECTOR_CIRCUIT_COOLDOWN_MS=30000
# ENTERPRISE_CONNECTORS_CONFIG_JSON={"erp":{"endpoint":"https://erp.example.local","path":"/agent/evidence","tokenEnv":"ERP_CONNECTOR_TOKEN"}}
# Production records require id, tenantId, organizationId, version, occurredAt,
# classification and statement. Missing scope/version is rejected, not inferred.
# timeRange filters event occurrence only; it does not provide an as-of snapshot.

# OA / BPM integration. Demo mode accepts only listed demo accounts and never infers a role from account text.
OA_AUTH_MODE=mock
DEMO_OA_PASSWORD=demo
# OA_OIDC_ISSUER=https://oa.example.com/oidc
# OIDC_AUDIENCE=healthcare-ai-agent
# OIDC_JWKS_URI=https://oa.example.com/oidc/.well-known/jwks.json
# OIDC_TENANT_ID=enterprise-tenant-id
# OIDC_ACCOUNT_CLAIM=email
# OIDC_ALLOWED_ALGORITHMS=RS256,ES256
# Future identity sources: LDAP_URL=ldaps://directory.example.com, WECHAT_WORK_CORP_ID=...

# Built-in account center is demo-only. Production must use OIDC, LDAP/AD, or another enterprise identity source.
ACCOUNT_AUTH_MODE=mock
DEMO_LOCAL_PASSWORD=demo

# Multimodal data egress is metadata-only by default. Enable only after enterprise security approval.
AGENT_LOCAL_MULTIMODAL_MODE=metadata_only
AGENT_EXTERNAL_MULTIMODAL_MODE=metadata_only
# Production should use required; unavailable scanners then fail closed.
MULTIMODAL_CONTENT_SECURITY_MODE=optional
# Optional cloud vision. Requires approved image egress AND enterprise scanner
# clean=true, dlpAction=allow. OCR text eligibility never authorizes raw images.
MULTIMODAL_VISUAL_PROVIDER=disabled
# MULTIMODAL_SECURITY_SCAN_ENDPOINT=https://content-security.example.local/v1/scan
# MULTIMODAL_OCR_ENDPOINT=https://ocr.example.local/v1/extract

# Client compatibility policy. Unidentified or unsupported clients receive HTTP 426 in production.
CLIENT_VERSION_POLICY_JSON={"web":{"minimumVersion":"0.1.0","recommendedVersion":"0.1.0"},"desktop":{"minimumVersion":"0.3.0","recommendedVersion":"0.3.0"},"mobile":{"minimumVersion":"0.3.0","recommendedVersion":"0.3.0"},"semantic-web":{"minimumVersion":"0.2.0","recommendedVersion":"0.2.0"},"semantic-desktop":{"minimumVersion":"0.2.0","recommendedVersion":"0.2.0"}}

# Security telemetry export. Inject bearer material from KMS; never place it in this file.
# SIEM_EXPORT_URL=https://siem-gateway.example.internal/events
# SIEM_EXPORT_TOKEN=inject-at-runtime-from-kms
# SIEM_EXPORT_HMAC_SECRET=inject-at-runtime-from-kms
# OBSERVABILITY_METRICS_TOKEN=inject-at-runtime-from-kms

# Key Center. Demo only emits short-lived opaque lease handles; raw credentials stay in the KMS/HSM boundary.
KEY_CENTER_PROVIDER=demo-kms
KEY_CENTER_HOST=127.0.0.1
KEY_CENTER_PORT=3010
KEY_CENTER_PROVIDER_TIMEOUT_MS=5000
# KEY_CENTER_PROVIDER_URL=https://credential-broker.example.com
# KEY_CENTER_WORKLOAD_ID=agent-api
# KEY_CENTER_PROVIDER_BEARER_TOKEN=inject-from-workload-secret
# Production: service identities must be authenticated by mTLS / workload identity before the Key Center API is exposed.
KEY_CENTER_TRUSTED_PRINCIPALS=api-gateway,key-center-admin
# Production: replace the adapter with a Vault / cloud-KMS / HSM implementation and use mTLS between services.
# KEY_CENTER_VAULT_ADDR=https://vault.example.com
# KEY_CENTER_MTLS_CA=/run/secrets/key-center-ca.pem

# Semantic context is a separate graph/provenance service. Port 3010 is reserved for Key Center.
SEMANTIC_CONTEXT_PORT=3011
